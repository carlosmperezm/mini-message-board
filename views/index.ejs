<html>
    <h1>Messages</h1>
    <ul>
        <% messages.forEach(message=>{ %>
            <li> User <%= message.user %>: <%= message.text %> on (<%= message.added %>) </li> 
            <a href="<%=`/details/${message.user}/${message.text}/${message.added}`%>" >Open</a>
        <% }) %>
    </ul>
<!-- </html> -->