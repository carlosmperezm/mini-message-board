<html>
    <h1>Send your own message !!</h1>
    <form method="POST" action="/new">
        <label for="username">
            username: 
            <input name="username" id="username"/>
        </label>
        <label for="message">
            message: 
            <textarea name="message" id="message"></textarea>
        </label>
        <button type="submit">Submit</button>
    </form>
</html>